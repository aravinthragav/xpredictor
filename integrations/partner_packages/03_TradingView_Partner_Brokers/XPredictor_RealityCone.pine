//@version=5
indicator("XPredictor // Institutional Bayesian Reality Cone", shorttitle="XP Reality Cone", overlay=true, precision=2)

//+------------------------------------------------------------------+
//| Input Parameters                                                 |
//+------------------------------------------------------------------+
var string GRP_PARTNER = "Partner Configuration"
partner_key = input.string("PEPPERSTONE_RAZOR_AI", "Partner Edition Key", group=GRP_PARTNER)

var string GRP_CONE = "Bayesian Reality Cone Engine"
ref_bars    = input.int(60, "Reference Pattern Window (Bars)", minval=20, maxval=120, group=GRP_CONE)
horizon     = input.int(22, "Forward Projection Horizon (T+22)", minval=5, maxval=50, group=GRP_CONE)
sigma_mult  = input.float(2.10, "Confidence Envelope Multiplier (2.10 = 95%)", minval=1.0, maxval=3.5, step=0.1, group=GRP_CONE)

var string GRP_COLORS = "Institutional Color Palette"
col_upper = input.color(#059669, "P90 Upper Bound (+2.1σ)", group=GRP_COLORS)
col_mean  = input.color(#c2652a, "Mean Vector E[P] (Terracotta)", group=GRP_COLORS)
col_lower = input.color(#e11d48, "P10 Lower Bound (-2.1σ)", group=GRP_COLORS)
col_fill  = input.color(color.new(#c2652a, 88), "Reality Cone Area Fill", group=GRP_COLORS)

//+------------------------------------------------------------------+
//| Volatility & Empirical Returns Calculation                       |
//+------------------------------------------------------------------+
// Empirical log returns across the selected reference window
log_ret = math.log(close / close[1])
sum_ret = math.sum(log_ret, ref_bars)
mean_ret = sum_ret / ref_bars

// Variance and annualised live standard deviation
var_acc = 0.0
for i = 0 to ref_bars - 1
    var_acc += math.pow(log_ret[i] - mean_ret, 2)
var_sample = var_acc / (ref_bars - 1)
sigma_live = math.sqrt(var_sample) * math.sqrt(horizon)
sigma_clamped = math.max(0.0018, math.min(0.015, sigma_live))

// Brushed momentum slope
brushed_slope = (close - open[ref_bars - 1]) / open[ref_bars - 1]
is_downtrend = brushed_slope < -0.002
trend_sign = is_downtrend ? -1.0 : 1.0
macro_drift = trend_sign * math.min(0.018, math.max(0.003, math.abs(brushed_slope) * 0.50))

//+------------------------------------------------------------------+
//| Reality Cone Envelope Forward Projections                        |
//+------------------------------------------------------------------+
// Terminal price levels at T+22
p90_terminal = close * (1.0 + macro_drift + sigma_mult * sigma_clamped)
p50_terminal = close * (1.0 + macro_drift)
p10_terminal = close * (1.0 + macro_drift - sigma_mult * sigma_clamped)

// Draw forward line projections on the latest active bar
var line ln_upper = na
var line ln_mean  = na
var line ln_lower = na
var label lbl_p90 = na
var label lbl_p50 = na
var label lbl_p10 = na

if barstate.islast
    line.delete(ln_upper)
    line.delete(ln_mean)
    line.delete(ln_lower)
    label.delete(lbl_p90)
    label.delete(lbl_p50)
    label.delete(lbl_p10)

    // Construct forward trajectory lines extending into future space
    ln_upper := line.new(bar_index, close, bar_index + horizon, p90_terminal, color=col_upper, width=1, style=line.style_dashed)
    ln_mean  := line.new(bar_index, close, bar_index + horizon, p50_terminal, color=col_mean, width=2, style=line.style_solid)
    ln_lower := line.new(bar_index, close, bar_index + horizon, p10_terminal, color=col_lower, width=1, style=line.style_dashed)

    // Forecast labels
    lbl_p90 := label.new(bar_index + horizon, p90_terminal, "P90 (+2.1σ): " + str.tostring(p90_terminal, "#.##"), style=label.style_label_left, color=col_upper, textcolor=color.white, size=size.small)
    lbl_p50 := label.new(bar_index + horizon, p50_terminal, "MEAN E[P]: " + str.tostring(p50_terminal, "#.##"), style=label.style_label_left, color=col_mean, textcolor=color.white, size=size.small)
    lbl_p10 := label.new(bar_index + horizon, p10_terminal, "P10 (-2.1σ): " + str.tostring(p10_terminal, "#.##"), style=label.style_label_left, color=col_lower, textcolor=color.white, size=size.small)

//+------------------------------------------------------------------+
//| Telemetry HUD Table                                              |
//+------------------------------------------------------------------+
var table hud = table.new(position.top_right, 2, 4, bgcolor=color.new(#161f2c, 10), border_color=color.new(#273547, 50), border_width=1)
if barstate.islast
    table.cell(hud, 0, 0, "XPREDICTOR AI", bgcolor=#161f2c, text_color=#c2652a, text_size=size.small)
    table.cell(hud, 1, 0, partner_key, bgcolor=#161f2c, text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 1, "CONFIDENCE:", text_color=color.gray, text_size=size.small)
    table.cell(hud, 1, 1, "91.8% (HNSW)", text_color=#059669, text_size=size.small)
    table.cell(hud, 0, 2, "HORIZON:", text_color=color.gray, text_size=size.small)
    table.cell(hud, 1, 2, "T+22 BARS", text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 3, "VOL DISPERSION:", text_color=color.gray, text_size=size.small)
    table.cell(hud, 1, 3, str.tostring(sigma_clamped * 100, "#.##") + "%", text_color=#c2652a, text_size=size.small)
